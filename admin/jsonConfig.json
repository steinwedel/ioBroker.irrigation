{
    "i18n": true,
    "type": "tabs",
    "items": {
        "_expertModeTab": {
            "type": "panel",
            "label": "General",
            "items": {
                "expertMode": {
                    "type": "checkbox",
                    "label": "Expert mode",
                    "help": "Show advanced options (sensors, weather, restrictions, notifications, flow monitoring, ...)",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "valvesTab": {
            "type": "panel",
            "label": "Valves",
            "items": {
                "autoDiscovery": {
                    "type": "panel",
                    "label": "Auto-Discovery",
                    "collapsable": true,
                    "newLine": true,
                    "items": {
                        "scanType": {
                            "type": "select",
                            "label": "System type to scan",
                            "options": [
                                { "label": "Gardena", "value": "Gardena" },
                                { "label": "Homematic", "value": "Homematic" },
                                { "label": "Rainbird", "value": "Rainbird" },
                                { "label": "Hydrawise", "value": "Hydrawise" },
                                { "label": "Generic (any adapter)", "value": "Generic" },
                                { "label": "All", "value": "All" }
                            ],
                            "default": "All",
                            "newLine": true,
                            "xs": 12,
                            "sm": 12,
                            "md": 4,
                            "lg": 3,
                            "xl": 3
                        },
                        "scanInstance": {
                            "type": "instance",
                            "label": "Adapter instance",
                            "adapter": "smartgarden",
                            "hidden": "data.scanType !== 'Gardena'",
                            "xs": 12,
                            "sm": 12,
                            "md": 4,
                            "lg": 3,
                            "xl": 3
                        },
                        "scanInstanceRainbird": {
                            "type": "instance",
                            "label": "Adapter instance",
                            "adapter": "rainbird",
                            "hidden": "data.scanType !== 'Rainbird'",
                            "xs": 12,
                            "sm": 12,
                            "md": 4,
                            "lg": 3,
                            "xl": 3
                        },
                        "scanInstanceHomematic": {
                            "type": "instance",
                            "label": "Adapter instance",
                            "adapter": "hm-rpc",
                            "allowDeactivate": true,
                            "help": "Leave empty to scan all Homematic instances.",
                            "hidden": "data.scanType !== 'Homematic'",
                            "xs": 12,
                            "sm": 12,
                            "md": 4,
                            "lg": 3,
                            "xl": 3
                        },
                        "scanInstanceHydrawise": {
                            "type": "instance",
                            "label": "Adapter instance",
                            "adapter": "hydrawise",
                            "allowDeactivate": true,
                            "help": "Leave empty to scan all Hydrawise instances.",
                            "hidden": "data.scanType !== 'Hydrawise'",
                            "xs": 12,
                            "sm": 12,
                            "md": 4,
                            "lg": 3,
                            "xl": 3
                        },
                        "_scanHomematicInfo": {
                            "type": "staticText",
                            "text": "Homematic discovery scans the \"Bewässerung\" function enum (enum.functions) for members with a switch state, optionally restricted to the selected adapter instance.",
                            "hidden": "data.scanType !== 'Homematic'",
                            "xs": 12,
                            "sm": 12,
                            "md": 8,
                            "lg": 6,
                            "xl": 6
                        },
                        "_scanGenericInfo": {
                            "type": "staticText",
                            "text": "Generic discovery scans the \"Bewässerung\"/\"Irrigation\" function enum (enum.functions) for members with a switch state, across all adapters. Adapters with a dedicated scan type (Gardena, Rainbird, Homematic, Hydrawise), the alias adapter and this irrigation adapter itself are always excluded.",
                            "hidden": "data.scanType !== 'Generic'",
                            "xs": 12,
                            "sm": 12,
                            "md": 8,
                            "lg": 6,
                            "xl": 6
                        },
                        "_scanAllInfo": {
                            "type": "staticText",
                            "text": "Runs Gardena, Rainbird, Homematic, Hydrawise and Generic discovery across all adapter instances in one go. The alias, admin and irrigation adapters are always excluded.",
                            "hidden": "data.scanType !== 'All'",
                            "xs": 12,
                            "sm": 12,
                            "md": 8,
                            "lg": 6,
                            "xl": 6
                        },
                        "scanButton": {
                            "type": "sendTo",
                            "label": "Scan for valves",
                            "command": "scanValves",
                            "jsonData": "{\"type\": \"${data.scanType}\", \"instance\": \"${data.scanInstance}\", \"instanceRainbird\": \"${data.scanInstanceRainbird}\", \"instanceHomematic\": \"${data.scanInstanceHomematic}\", \"instanceHydrawise\": \"${data.scanInstanceHydrawise}\"}",
                            "useNative": true,
                            "showProcess": true,
                            "result": {
                                "scanDone": "Scan finished: found and added %s new valve(s) (%s total)."
                            },
                            "error": {
                                "scanErrors": "Scan finished with errors, see the log for details."
                            },
                            "xs": 12,
                            "sm": 12,
                            "md": 4,
                            "lg": 3,
                            "xl": 3
                        },
                        "scanProgress": {
                            "type": "state",
                            "label": "Progress",
                            "oid": "scan.progress",
                            "control": "text",
                            "xs": 12,
                            "sm": 12,
                            "md": 8,
                            "lg": 6,
                            "xl": 6
                        }
                    }
                },
                "valves": {
                    "type": "table",
                    "label": "Valves",
                    "newLine": true,
                    "items": [
                        {
                            "type": "text",
                            "attr": "valveNumber",
                            "title": "Valve",
                            "width": "8%",
                            "readOnly": true,
                            "sort": true
                        },
                        {
                            "type": "text",
                            "attr": "name",
                            "title": "Display name",
                            "width": "24%",
                            "sort": true
                        },
                        {
                            "type": "select",
                            "attr": "type",
                            "title": "Type",
                            "width": "14%",
                            "sort": true,
                            "options": [
                                { "label": "Gardena", "value": "Gardena" },
                                { "label": "Homematic", "value": "Homematic" },
                                { "label": "Rainbird", "value": "Rainbird" },
                                { "label": "Hydrawise", "value": "Hydrawise" },
                                { "label": "Generic", "value": "Generic" }
                            ]
                        },
                        {
                            "type": "number",
                            "attr": "duration",
                            "title": "Watering duration (min)",
                            "width": "16%",
                            "min": 1,
                            "default": 10,
                            "sort": true
                        },
                        {
                            "type": "objectId",
                            "attr": "stateId",
                            "title": "State id",
                            "width": "30%",
                            "sort": true
                        }
                    ]
                },
                "deleteAllValves": {
                    "type": "sendTo",
                    "label": "Delete all valves",
                    "command": "deleteAllValves",
                    "icon": "data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIGhlaWdodD0iMjQiIHZpZXdCb3g9IjAgMCAyNCAyNCIgd2lkdGg9IjI0Ij48cGF0aCBkPSJNNiAxOWMwIDEuMS45IDIgMiAyaDhjMS4xIDAgMi0uOSAyLTJWN0g2djEyek0xOSA0aC0zLjVsLTEtMWgtNWwtMSAxSDV2MmgxNFY0eiIvPjwvc3ZnPg==",
                    "color": "secondary",
                    "useNative": true,
                    "confirm": {
                        "text": "This deletes all valves from the configuration. This cannot be undone.",
                        "title": "Delete all valves?",
                        "type": "warning",
                        "ok": "Delete",
                        "cancel": "Cancel"
                    },
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                }
            }
        },
        "_plansTab": {
            "type": "panel",
            "label": "Plans",
            "items": {
                "planEditorHeader": {
                    "type": "header",
                    "text": "Manage plans",
                    "size": 4,
                    "newLine": true
                },
                "_editPlan": {
                    "type": "selectSendTo",
                    "label": "Selected plan",
                    "command": "listPlans",
                    "jsonData": "{}",
                    "alsoDependsOn": ["plans"],
                    "doNotSave": true,
                    "newLine": true,
                    "sm": 6,
                    "md": 4,
                    "lg": 3
                },
                "deletePlan": {
                    "type": "sendTo",
                    "label": "Delete selected plan",
                    "command": "deletePlan",
                    "jsonData": "{\"_editPlan\": ${JSON.stringify(data._editPlan ?? null)}}",
                    "alsoDependsOn": ["_editPlan"],
                    "useNative": true,
                    "icon": "delete",
                    "color": "secondary",
                    "confirm": {
                        "text": "This deletes the selected plan and its valve assignment. This cannot be undone.",
                        "title": "Delete plan?",
                        "type": "warning",
                        "ok": "Delete",
                        "cancel": "Cancel"
                    },
                    "error": {
                        "noSelection": "No plan selected.",
                        "lastPlan": "The last remaining plan cannot be deleted."
                    },
                    "sm": 6,
                    "md": 4,
                    "lg": 3
                },
                "planName": {
                    "type": "text",
                    "label": "Plan name",
                    "newLine": true,
                    "doNotSave": true,
                    "sm": 6,
                    "md": 4,
                    "lg": 3
                },
                "renamePlan": {
                    "type": "sendTo",
                    "label": "Rename selected plan",
                    "command": "renamePlan",
                    "jsonData": "{\"_editPlan\": ${JSON.stringify(data._editPlan ?? null)}, \"planName\": ${JSON.stringify(data.planName ?? '')}}",
                    "alsoDependsOn": ["_editPlan", "planName"],
                    "useNative": true,
                    "disabled": "!data.planName || !data.planName.trim()",
                    "confirm": {
                        "text": "Rename the selected plan to \"${data.planName}\"?",
                        "title": "Rename plan?",
                        "type": "info",
                        "ok": "Rename",
                        "cancel": "Cancel",
                        "alsoDependsOn": ["planName"]
                    },
                    "icon": "edit",
                    "variant": "contained",
                    "error": {
                        "noSelection": "No plan selected.",
                        "noName": "Please enter a new plan name.",
                        "nameExists": "A plan with this name already exists."
                    },
                    "sm": 6,
                    "md": 4,
                    "lg": 3
                },

                "addPlan": {
                    "type": "sendTo",
                    "label": "Add new plan",
                    "command": "createPlan",
                    "jsonData": "{\"planName\": ${JSON.stringify(data.planName ?? '')}}",
                    "alsoDependsOn": ["planName"],
                    "useNative": true,
                    "disabled": "!data.planName || !data.planName.trim()",
                    "confirm": {
                        "text": "Create new plan \"${data.planName}\"?",
                        "title": "Add new plan?",
                        "type": "info",
                        "ok": "Create",
                        "cancel": "Cancel",
                        "alsoDependsOn": ["planName"]
                    },
                    "icon": "add",
                    "variant": "contained",
                    "error": {
                        "noName": "Please enter a name for the new plan."
                    },
                    "sm": 6,
                    "md": 4,
                    "lg": 3
                },
                "planValvesHeader": {
                    "type": "header",
                    "text": "Valve assignment",
                    "size": 4
                },
                "planValvesHint": {
                    "type": "staticText",
                    "text": "After changing \"Selected plan\" above, click \"Load valves for selected plan\" to refresh the table below. Tick/untick valves and use the up/down arrow buttons to set their order. Click \"Apply valve assignment\" to save. The order is used when the pump capacity is 0 (sequential watering).",
                    "newLine": true,
                    "sm": 12,
                    "md": 12,
                    "lg": 8
                },
                "loadPlanValveTable": {
                    "type": "sendTo",
                    "label": "Load valves for selected plan",
                    "command": "loadPlanValveTable",
                    "jsonData": "{\"_editPlan\": ${JSON.stringify(data._editPlan ?? null)}}",
                    "useNative": true,
                    "onLoaded": true,
                    "icon": "refresh",
                    "variant": "outlined",
                    "newLine": true,
                    "sm": 6,
                    "md": 4,
                    "lg": 3
                },
                "applyPlanValveTable": {
                    "type": "sendTo",
                    "label": "Apply valve assignment",
                    "command": "applyPlanValveTable",
                    "jsonData": "{\"_editPlan\": ${JSON.stringify(data._editPlan ?? null)}, \"planValveTable\": ${JSON.stringify(data.planValveTable ?? [])}}",
                    "alsoDependsOn": ["_editPlan", "planValveTable"],
                    "useNative": true,
                    "icon": "save",
                    "variant": "contained",
                    "error": {
                        "noSelection": "No plan selected."
                    },
                    "sm": 6,
                    "md": 4,
                    "lg": 3
                },
                "planValveTable": {
                    "type": "table",
                    "label": "Valves in selected plan",
                    "newLine": true,
                    "doNotSave": true,
                    "noDelete": false,
                    "sm": 12,
                    "md": 12,
                    "lg": 8,
                    "items": [
                        {
                            "type": "staticText",
                            "attr": "_rowPosition",
                            "title": "Number",
                            "text": "${arrayIndex + 1}",
                            "noTranslation": true,
                            "width": "10%"
                        },
                        {
                            "type": "checkbox",
                            "attr": "assigned",
                            "title": "In plan",
                            "width": "15%",
                            "sort": true
                        },
                        {
                            "type": "text",
                            "attr": "valveNumber",
                            "title": "Valve",
                            "width": "15%",
                            "readOnly": true,
                            "sort": true
                        },
                        {
                            "type": "text",
                            "attr": "name",
                            "title": "Name",
                            "width": "60%",
                            "readOnly": true,
                            "sort": true
                        }
                    ]
                }
            }
        },
        "_controlTab": {
            "type": "panel",
            "label": "Control",
            "items": {
                "scheduler.autoMode": {
                    "type": "checkbox",
                    "label": "Automatic mode enabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "scheduler.timerTimes": {
                    "type": "chips",
                    "label": "Timer times (HH:MM)",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "scheduler.extensionFactor": {
                    "type": "number",
                    "label": "Duration extension factor",
                    "min": 0.5,
                    "max": 5,
                    "step": 0.1,
                    "newLine": true,
                    "hidden": "!data.expertMode",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "scheduler.temperatureAdjustmentStateId": {
                    "type": "objectId",
                    "label": "Temperature state for irrigation adjustment",
                    "help": "Current temperature in °C used to calculate the watering duration factor.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "scheduler.temperatureAdjustmentEnabled": {
                    "type": "checkbox",
                    "label": "Temperature-controlled irrigation adjustment",
                    "help": "Adjusts automatic plan durations by 7% per °C relative to 20 °C.",
                    "disabled": "!data.scheduler?.temperatureAdjustmentStateId",
                    "onChange": {
                        "alsoDependsOn": ["scheduler.temperatureAdjustmentStateId"],
                        "calculateFunc": "data.scheduler?.temperatureAdjustmentStateId ? data.scheduler?.temperatureAdjustmentEnabled : false",
                        "ignoreOwnChanges": true
                    },
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "scheduler.pumpCapacity": {
                    "type": "number",
                    "label": "Pump capacity (l/min, 0 = sequential only)",
                    "min": 0,
                    "hidden": "!data.expertMode",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "scheduler.valvePause": {
                    "type": "number",
                    "label": "Pause between batches (min)",
                    "min": 0,
                    "hidden": "!data.expertMode",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "scheduler.seasonEnabled": {
                    "type": "checkbox",
                    "label": "Season pause enabled",
                    "newLine": true,
                    "hidden": "!data.expertMode",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "scheduler.seasonStart": {
                    "type": "number",
                    "label": "Season start month",
                    "min": 1,
                    "max": 12,
                    "hidden": "!data.expertMode",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "scheduler.seasonEnd": {
                    "type": "number",
                    "label": "Season end month",
                    "min": 1,
                    "max": 12,
                    "hidden": "!data.expertMode",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "scheduler.frostEnabled": {
                    "type": "checkbox",
                    "label": "Frost protection enabled",
                    "newLine": true,
                    "hidden": "!data.expertMode",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "scheduler.frostMinTemp": {
                    "type": "number",
                    "label": "Frost protection minimum temperature (°C)",
                    "hidden": "!data.expertMode",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "scheduler.icalAdapterInstance": {
                    "type": "instance",
                    "label": "iCal adapter instance",
                    "adapter": "ical",
                    "newLine": true,
                    "hidden": "!data.expertMode",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "scheduler.icalTriggerState": {
                    "type": "objectId",
                    "label": "iCal trigger state id",
                    "hidden": "!data.expertMode",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "scheduler.icalTitlePrefix": {
                    "type": "text",
                    "label": "iCal event title prefix",
                    "hidden": "!data.expertMode",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "_sensorsTab": {
            "type": "panel",
            "label": "Sensors",
            "hidden": "!data.expertMode",
            "items": {
                "sensors.rainId": {
                    "type": "objectId",
                    "label": "Rain sensor state id",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "sensors.soilMoistureId": {
                    "type": "objectId",
                    "label": "Soil moisture sensor state id",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "sensors.temperatureId": {
                    "type": "objectId",
                    "label": "Temperature sensor state id",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "_weatherTab": {
            "type": "panel",
            "label": "Weather API",
            "hidden": "!data.expertMode",
            "items": {
                "weather.enabled": {
                    "type": "checkbox",
                    "label": "Weather API enabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "weather.apiType": {
                    "type": "select",
                    "label": "API type",
                    "options": [{ "label": "OpenWeatherMap", "value": "openweathermap" }],
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "weather.apiKey": {
                    "type": "password",
                    "label": "API key",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "weather.latitude": {
                    "type": "number",
                    "label": "Latitude",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "weather.longitude": {
                    "type": "number",
                    "label": "Longitude",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "weather.pollInterval": {
                    "type": "number",
                    "label": "Poll interval (min)",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "_legalRestrictionTab": {
            "type": "panel",
            "label": "Legal restriction",
            "hidden": "!data.expertMode",
            "items": {
                "legalRestriction.enabled": {
                    "type": "checkbox",
                    "label": "Legal restriction check enabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "legalRestriction.stationId": {
                    "type": "selectSendTo",
                    "label": "DWD station",
                    "command": "listDwdStations",
                    "jsonData": "{}",
                    "onChange": {
                        "alsoDependsOn": ["legalRestriction.temperatureStateId"],
                        "calculateFunc": "data.legalRestriction?.temperatureStateId ? '' : data.legalRestriction?.stationId",
                        "ignoreOwnChanges": true
                    },
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "legalRestriction.temperatureStateId": {
                    "type": "objectId",
                    "label": "Local temperature state",
                    "help": "If selected, this state is used instead of the DWD station.",
                    "onChange": {
                        "alsoDependsOn": ["legalRestriction.stationId"],
                        "calculateFunc": "data.legalRestriction?.stationId ? '' : data.legalRestriction?.temperatureStateId",
                        "ignoreOwnChanges": true
                    },
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "legalRestriction.startDate": {
                    "type": "text",
                    "label": "Restriction start date",
                    "placeholder": "13.5",
                    "validator": "(!data.legalRestriction?.startDate && !data.legalRestriction?.endDate) || (/^(?:(?:[1-9]|[12]\\d|3[01])\\.(?:1|3|5|7|8|10|12)|(?:[1-9]|[12]\\d|30)\\.(?:4|6|9|11)|(?:[1-9]|1\\d|2[0-9])\\.2)$/.test(data.legalRestriction?.startDate || '') && /^(?:(?:[1-9]|[12]\\d|3[01])\\.(?:1|3|5|7|8|10|12)|(?:[1-9]|[12]\\d|30)\\.(?:4|6|9|11)|(?:[1-9]|1\\d|2[0-9])\\.2)$/.test(data.legalRestriction?.endDate || ''))",
                    "validatorErrorText": "Enter both dates as valid D.M values or leave both empty.",
                    "validatorNoSaveOnError": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "legalRestriction.endDate": {
                    "type": "text",
                    "label": "Restriction end date",
                    "placeholder": "13.9",
                    "disabled": "!data.legalRestriction?.startDate",
                    "onChange": {
                        "alsoDependsOn": ["legalRestriction.startDate"],
                        "calculateFunc": "data.legalRestriction?.startDate ? data.legalRestriction?.endDate : ''",
                        "ignoreOwnChanges": true
                    },
                    "validator": "(!data.legalRestriction?.startDate && !data.legalRestriction?.endDate) || (/^(?:(?:[1-9]|[12]\\d|3[01])\\.(?:1|3|5|7|8|10|12)|(?:[1-9]|[12]\\d|30)\\.(?:4|6|9|11)|(?:[1-9]|1\\d|2[0-9])\\.2)$/.test(data.legalRestriction?.startDate || '') && /^(?:(?:[1-9]|[12]\\d|3[01])\\.(?:1|3|5|7|8|10|12)|(?:[1-9]|[12]\\d|30)\\.(?:4|6|9|11)|(?:[1-9]|1\\d|2[0-9])\\.2)$/.test(data.legalRestriction?.endDate || ''))",
                    "validatorErrorText": "Enter both dates as valid D.M values or leave both empty.",
                    "validatorNoSaveOnError": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "legalRestriction.startTime": {
                    "type": "text",
                    "label": "Restriction start time",
                    "placeholder": "15:10",
                    "validator": "(!data.legalRestriction?.startTime && !data.legalRestriction?.endTime) || (/^(?:[01]\\d|2[0-3]):[0-5]\\d$/.test(data.legalRestriction?.startTime || '') && /^(?:[01]\\d|2[0-3]):[0-5]\\d$/.test(data.legalRestriction?.endTime || ''))",
                    "validatorErrorText": "Enter both times as valid HH:MM values or leave both empty.",
                    "validatorNoSaveOnError": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "legalRestriction.endTime": {
                    "type": "text",
                    "label": "Restriction end time",
                    "placeholder": "17:00",
                    "disabled": "!data.legalRestriction?.startTime",
                    "onChange": {
                        "alsoDependsOn": ["legalRestriction.startTime"],
                        "calculateFunc": "data.legalRestriction?.startTime ? data.legalRestriction?.endTime : ''",
                        "ignoreOwnChanges": true
                    },
                    "validator": "(!data.legalRestriction?.startTime && !data.legalRestriction?.endTime) || (/^(?:[01]\\d|2[0-3]):[0-5]\\d$/.test(data.legalRestriction?.startTime || '') && /^(?:[01]\\d|2[0-3]):[0-5]\\d$/.test(data.legalRestriction?.endTime || ''))",
                    "validatorErrorText": "Enter both times as valid HH:MM values or leave both empty.",
                    "validatorNoSaveOnError": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "legalRestriction.minTemperature": {
                    "type": "number",
                    "label": "Maximum irrigation temperature (°C)",
                    "disabled": "!data.legalRestriction?.stationId && !data.legalRestriction?.temperatureStateId",
                    "alsoDependsOn": ["legalRestriction.stationId", "legalRestriction.temperatureStateId"],
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "legalRestriction.checkInterval": {
                    "type": "number",
                    "label": "Check interval (min)",
                    "min": 1,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "_notificationsTab": {
            "type": "panel",
            "label": "Notifications",
            "hidden": "!data.expertMode",
            "items": {
                "notifications.pushoverInstance": {
                    "type": "instance",
                    "label": "Pushover instance",
                    "adapter": "pushover",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "notifications.telegramInstance": {
                    "type": "instance",
                    "label": "Telegram instance",
                    "adapter": "telegram",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "waterConsumption.enabled": {
                    "type": "checkbox",
                    "label": "Water consumption tracking enabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                }
            }
        }
    }
}
